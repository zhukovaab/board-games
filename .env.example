# --- Postgres ---
POSTGRES_DB=boardgames
POSTGRES_USER=boardgames
POSTGRES_PASSWORD=boardgames
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Порт, на котором база видна с хоста (внутри сети всегда 5432)
POSTGRES_HOST_PORT=5433

# --- Backend (Litestar) ---
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# Залить демо-данные при старте (идемпотентно). Поставь 0, когда заведёшь свои игры.
SEED_ON_START=1
# Токен для записи через POST/PATCH/DELETE /api/admin/games (Authorization: Bearer <token>).
# Пусто = ручки записи выключены. Сгенерировать: openssl rand -hex 32
ADMIN_API_TOKEN=

# --- Admin (Django) ---
ADMIN_PORT=8001
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:8000
VITE_MEDIA_URL=http://localhost:8000/media
