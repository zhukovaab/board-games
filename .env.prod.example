# Шаблон продовых переменных. Скопируй на сервере в .env.prod и заполни
# реальными значениями — сам .env.prod в git не попадает (см. .gitignore).
#
#   cp .env.prod.example .env.prod

# --- Postgres ---
POSTGRES_DB=boardgames
POSTGRES_USER=boardgames
# Сгенерируй сильный пароль, например: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# --- Backend (Litestar) ---
# Залить демо-данные при старте. На проде держим 0.
SEED_ON_START=0
# Токен для записи через POST/PATCH/DELETE /api/admin/games (Authorization: Bearer <token>).
# Сгенерируй: openssl rand -hex 32. Пусто = ручки записи выключены.
ADMIN_API_TOKEN=change-me-generate-a-real-token

# --- Admin (Django) ---
# Сгенерируй ключ: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-real-secret
DJANGO_DEBUG=0
# IP или домен сервера (без схемы, через запятую)
DJANGO_ALLOWED_HOSTS=203.0.113.10
# То же самое, но со схемой http:// (позже, с доменом и TLS — https://)
DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=change-me
DJANGO_SUPERUSER_EMAIL=admin@example.com

# --- Образы (GHCR) ---
# Какой тег образов раскатывать. По умолчанию latest — то, что собрал
# последний прогон CI на main. Для отката на конкретную версию поставь
# сюда SHA нужного коммита (см. docs/deploy.md, раздел «Откат»).
# IMAGE_TAG=latest
